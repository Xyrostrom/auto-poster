# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is in .gitignore: it is never uploaded to GitHub. Never share it.
# No quotes and no spaces around "=".

# --- Google (Drive + YouTube) - see SETUP-GUIDE.md, Part 3 ---
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxx

# YouTube channel that receives uploads (e.g. a brand channel like @tech.nexvora).
# Mint with: python scripts/auth_setup.py --youtube  (pick the channel on the Google screen)
# Empty = upload to the channel of the GOOGLE_REFRESH_TOKEN account.
YOUTUBE_REFRESH_TOKEN=
# Safety check: refuse to upload if the token is for any other channel. Empty = no check.
YT_CHANNEL_ID=

# The part after /folders/ in your Drive folder link
DRIVE_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Anthropic (AI captions) - Part 4. Leave empty to use simple template captions ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- Optional ---
# One line about your channel; helps the AI write better captions
CONTENT_CONTEXT=Indian cricket and stand-up comedy clips
# public, unlisted or private
YT_PRIVACY=public
# Which platforms run-local.ps1 posts to: youtube  or  youtube,instagram
PLATFORMS=youtube

# --- Instagram (Part 6) - only needed if PLATFORMS includes instagram ---
IG_USER_ID=
IG_ACCESS_TOKEN=
STAGING_REPO=your-github-username/auto-poster-media
STAGING_TOKEN=
